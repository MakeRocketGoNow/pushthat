<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device transfer on Android 12 and newer (backup_rules.xml is the same for
   older versions).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <!-- The account key, wrapped under a Keystore key that never leaves this phone, and
         this install's deviceId (AccountKeyStore). Restored elsewhere, the first could not
         be opened and the second would give two installs one id. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="e2ee_keys.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="e2ee_keys.xml"/>
    </device-transfer>
</data-extraction-rules>
