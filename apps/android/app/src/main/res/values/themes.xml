<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.LinkShare" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary_variant</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <!-- Status bar. statusBarColor is ignored from Android 15 on, where the
             window is edge to edge and the toolbar draws its own background
             behind the status bar; it still applies below that. Either way the
             backdrop is the light pink toolbar in both light and dark mode, so
             the icons must stay dark instead of following DayNight. -->
        <item name="android:statusBarColor">@color/color_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Background colors -->
        <item name="android:colorBackground">@color/color_background</item>
        <item name="popupMenuBackground">@color/color_background</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/color_on_background</item>
        <item name="android:textColorSecondary">@color/color_on_surface</item>
        <!-- Button styles -->
        <item name="buttonStyle">@style/Widget.LinkShare.Button</item>
    </style>

    <style name="Theme.LinkShare.WithActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Inherit all colors from base theme -->
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_variant</item>
        <item name="colorOnPrimary">@color/color_on_primary</item>
        <item name="colorSecondary">@color/color_secondary</item>
        <item name="colorSecondaryVariant">@color/color_secondary_variant</item>
        <item name="colorOnSecondary">@color/color_on_secondary</item>
        <item name="android:statusBarColor">@color/color_primary</item>
        <!-- Text colors for dark theme -->
        <item name="android:textColorPrimary">@color/color_on_background</item>
        <item name="android:textColorSecondary">@color/color_on_surface</item>
    </style>

    <!-- Custom button styles -->
    <style name="Widget.LinkShare.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.LinkShare.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/button_outline_background</item>
        <item name="android:textColor">@color/color_primary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- The sign-in screen's buttons, used there and by views shared with screens on the
         MaterialComponents theme: parented on AppCompat's button so they look the same
         whichever theme inflates them. -->
    <style name="Widget.LinkShare.PrimaryButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_background</item>
        <item name="android:textColor">@color/color_on_primary</item>
        <item name="android:padding">16dp</item>
    </style>

    <style name="Widget.LinkShare.OutlineButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_outline_background</item>
        <item name="android:textColor">@color/color_action</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- Text on the sign-in, recovery key and settings screens. -->
    <style name="Widget.LinkShare.Title" parent="">
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.LinkShare.Body" parent="">
        <item name="android:textColor">@color/color_text_secondary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="Widget.LinkShare.ErrorText" parent="">
        <item name="android:textColor">@color/color_error</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Monospaced so that 0 and O, 1 and I cannot be mistaken while it is copied out by
         hand, and selectable so it can be copied in pieces too. -->
    <style name="Widget.LinkShare.RecoveryKey" parent="">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textIsSelectable">true</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- A text field on the sign-in screen and in the settings dialogs. -->
    <style name="Widget.LinkShare.Input" parent="">
        <item name="android:background">@drawable/input_background</item>
        <item name="android:padding">16dp</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="android:textColorHint">@color/input_hint</item>
    </style>

    <style name="PopupMenuStyle" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:textColor">@color/color_action</item>
        <item name="android:itemBackground">@color/color_surface</item>
        <item name="materialThemeOverlay">@style/PopupMenuOverlay</item>
        <item name="android:dropDownHorizontalOffset">-4dp</item>
        <item name="android:dropDownVerticalOffset">4dp</item>
        <item name="android:popupBackground">@drawable/custom_popup_background</item>
        <item name="popupMenuBackground">@drawable/custom_popup_background</item>
    </style>

    <style name="PopupMenuOverlay">
        <item name="colorSurface">@color/color_surface</item>
    </style>

    <style name="PopupMenuTextStyle" parent="Widget.MaterialComponents.PopupMenu.Overflow">
        <item name="android:textColor">@color/color_action</item>
        <item name="android:background">@color/color_surface</item>
    </style>

    <style name="DeleteDialogStyle" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="android:background">@color/color_surface</item>
        <item name="android:textColor">@color/color_text</item>
        <item name="buttonBarPositiveButtonStyle">@style/DeleteDialogButtonStyle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DeleteDialogButtonStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/DeleteDialogTitleStyle</item>
    </style>

    <style name="DeleteDialogButtonStyle" parent="Widget.MaterialComponents.Button.TextButton.Dialog">
        <item name="android:textColor">@color/color_action</item>
    </style>

    <style name="DeleteDialogTitleStyle" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/color_primary</item>
    </style>

    <style name="SearchViewStyle" parent="Widget.AppCompat.SearchView">
        <item name="android:textColor">@color/color_on_surface</item>
        <item name="android:editTextColor">@color/color_on_surface</item>
        <item name="android:textColorHint">@color/color_on_surface_variant</item>
        <item name="queryBackground">@null</item>
        <item name="searchIcon">@null</item>
        <item name="closeIcon">@null</item>
        <item name="android:textCursorDrawable">@null</item>
        <item name="android:textColorPrimary">@color/color_on_surface</item>
        <item name="android:textColorSecondary">@color/color_on_surface</item>
    </style>
</resources>