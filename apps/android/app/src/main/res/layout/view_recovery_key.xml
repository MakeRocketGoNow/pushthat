<?xml version="1.0" encoding="utf-8"?>
<!-- The recovery key, shown once: after registration or a migration on the sign-in screen,
     and from the menu's "Show a new recovery key" in a dialog (RecoveryKeyView binds it).
     AppCompatButton rather than Button, so it looks the same under the sign-in screen's
     AppCompat theme and the list's MaterialComponents one, which would otherwise swap in
     a MaterialButton and tint the background. -->
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">

  <TextView
    android:id="@+id/recoveryKeyTitle"
    style="@style/Widget.LinkShare.Title"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    android:text="@string/recovery_key_title" />

  <TextView
    style="@style/Widget.LinkShare.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/recovery_key_body" />

  <TextView
    style="@style/Widget.LinkShare.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:text="@string/recovery_key_shown_once" />

  <TextView
    android:id="@+id/recoveryKeyText"
    style="@style/Widget.LinkShare.RecoveryKey"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp" />

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/recoveryKeyCopy"
    style="@style/Widget.LinkShare.OutlineButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:text="@string/copy" />

  <androidx.appcompat.widget.AppCompatButton
    android:id="@+id/recoveryKeySaved"
    style="@style/Widget.LinkShare.PrimaryButton"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="16dp"
    android:text="@string/recovery_key_saved" />

</LinearLayout>
