<?xml version="1.0" encoding="utf-8"?>
<!-- One screen for every step before the push list: the sign-in and registration form,
     the recovery key prompt and the recovery key itself. LoginActivity shows the views
     each step needs. A ScrollView, since the recovery key and its copy do not fit a small
     phone with the keyboard up. -->
<ScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/loginRoot"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/color_background"
  android:clipToPadding="false"
  android:fillViewport="true"
  android:padding="24dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="vertical">

    <ImageView
      android:id="@+id/logoImage"
      android:layout_width="96dp"
      android:layout_height="96dp"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="40dp"
      android:src="@drawable/logo"
      android:contentDescription="@string/logo_description" />

    <TextView
      android:id="@+id/titleText"
      style="@style/Widget.LinkShare.Title"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="24dp"
      android:gravity="center"
      android:text="@string/sign_in_to_pushthat" />

    <TextView
      android:id="@+id/bodyText"
      style="@style/Widget.LinkShare.Body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:visibility="gone" />

    <EditText
      android:id="@+id/emailInput"
      style="@style/Widget.LinkShare.Input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:hint="@string/email"
      android:inputType="textEmailAddress"
      android:autofillHints="emailAddress" />

    <EditText
      android:id="@+id/passwordInput"
      style="@style/Widget.LinkShare.Input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:hint="@string/password"
      android:inputType="textPassword"
      android:autofillHints="password" />

    <TextView
      android:id="@+id/forgotPasswordText"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end"
      android:layout_marginTop="16dp"
      android:text="@string/forgot_password"
      android:textColor="@color/color_text_secondary"
      android:padding="8dp" />

    <!-- Not a password field: the key is read off paper or another screen, and seeing it
         is how a mistyped symbol gets caught. -->
    <EditText
      android:id="@+id/recoveryInput"
      style="@style/Widget.LinkShare.Input"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:fontFamily="monospace"
      android:hint="@string/recovery_key_hint"
      android:importantForAutofill="no"
      android:inputType="textCapCharacters|textNoSuggestions|textVisiblePassword"
      android:visibility="gone" />

    <include
      android:id="@+id/recoveryKeyView"
      layout="@layout/view_recovery_key"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:visibility="gone" />

    <TextView
      android:id="@+id/errorText"
      style="@style/Widget.LinkShare.ErrorText"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:visibility="gone" />

    <ProgressBar
      android:id="@+id/progress"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center_horizontal"
      android:layout_marginTop="16dp"
      android:indeterminateTint="@color/color_primary"
      android:visibility="gone" />

    <Button
      android:id="@+id/loginButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="32dp"
      android:background="@drawable/button_background"
      android:text="@string/sign_in"
      android:textColor="@color/black"
      android:padding="16dp" />

    <Button
      android:id="@+id/registerButton"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:background="@drawable/button_outline_background"
      android:padding="16dp"
      android:text="@string/register"
      android:textColor="@color/color_action" />

  </LinearLayout>
</ScrollView>
