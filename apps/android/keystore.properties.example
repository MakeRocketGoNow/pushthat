# Copy this file to keystore.properties and fill in your own values.
#
#   cp keystore.properties.example keystore.properties
#
# keystore.properties is gitignored - never commit it, and never commit the
# keystore itself. Without it the release build is left unsigned, which is what
# a fresh clone gets.
#
# With it, ./gradlew bundleRelease produces a signed AAB for trying a release
# build locally. Bundles for Play come from CI: a local one keeps a version code
# Play has already seen. See "Shipping to Play" in docs/android.md.

# Path to the upload keystore. Relative paths resolve against the repo root;
# absolute paths are used as given. Keeping the keystore outside the repo is
# recommended. The file needs no particular extension.
#
# If this path is wrong the release build fails with
#   "Keystore file '...' not found for signing config 'release'"
# rather than falling back to unsigned, so a typo cannot quietly ship an
# unsigned bundle.
storeFile=/ABSOLUTE/PATH/TO/YOUR/KEYSTORE

# For a PKCS12 keystore these two are the same value.
storePassword=
keyPassword=

# Confirm with: keytool -list -v -keystore <storeFile>
keyAlias=
