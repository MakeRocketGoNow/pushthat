{
  "manifest_version": 3,
  "name": "PushThat",
  "version": "2.0.0",
  "action": {},

  "background": {
    "service_worker": "chrome/background.ts",
    "type": "module"
  },
  "permissions": ["tabs", "storage", "notifications"],
  "host_permissions": ["https://fcm.googleapis.com/*"],
  "web_accessible_resources": [
    {
      "matches": ["<all_urls>"],
      "resources": ["index.html"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
